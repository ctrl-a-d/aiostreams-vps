# Copy this file to .env and replace every required placeholder before deployment.

TZ=Europe/Berlin
DOCKER_DIR=/opt/aiostreams
DOCKER_DATA_DIR=${DOCKER_DIR}/data
PUID=1000
PGID=1000

COMPOSE_PROFILES=required,aiostreams,aiometadata,crowdsec,nzbhydra2,stremthru,syncio,watchtower

LETSENCRYPT_EMAIL=admin@example.com
DOMAIN=example.com

# Generate independent values with: openssl rand -hex 32
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_JWT_SECRET=
AUTHELIA_POSTGRES_PASSWORD=

AIOMETADATA_HOSTNAME=aiometadata.${DOMAIN}
AIOSTREAMS_HOSTNAME=aiostreams.${DOMAIN}
AUTHELIA_HOSTNAME=auth.${DOMAIN}
NZBHYDRA2_HOSTNAME=nzbhydra2.${DOMAIN}
STREMTHRU_HOSTNAME=stremthru.${DOMAIN}
SYNCIO_HOSTNAME=syncio.${DOMAIN}
TRAEFIK_HOSTNAME=traefik.${DOMAIN}

COMPOSE_PROJECT_NAME=aiostreams
COMPOSE_REMOVE_ORPHANS=true
COMPOSE_BAKE=true
DOCKER_NETWORK=aiostreams
DOCKER_NETWORK_EXTERNAL=false
